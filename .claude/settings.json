{
  "model": "opusplan",
  "advisorModel": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/pending-validation.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/usage-guard.py\" --mode session 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/usage-guard.py\" --mode prompt 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
