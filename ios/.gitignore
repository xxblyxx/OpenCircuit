# Generated by XcodeGen — regenerate with `xcodegen generate`.
*.xcodeproj
# Local signing override (personal team/bundle id) — keeps project.yml conflict-free on upstream merges.
project.local.yml
# App Group entitlements (docs/WIDGETS_HOME_SCREEN.md) — hold the personal group id
# (group.com.bly.opencircuit), generated by project.local.yml. Distinct paths from the tracked
# OpenCircuit.entitlements files so a bare `xcodegen generate` never touches them.
OpenCircuit/OpenCircuit.local.entitlements
WorkoutWidget/WorkoutWidget.local.entitlements
# SwiftPM / Xcode build artifacts
.build/
.swiftpm/
DerivedData/
OpenCircuitKit/.build/
# Device/archive derived-data path used by CLI builds (xcodebuild -derivedDataPath)
build-device/
build/
# Throwaway icon background candidates — only branding/logo.svg + AppIcon.appiconset are committed
OpenCircuit/branding/candidates/

# Xcode simulator derived data (local build output)
build-sim/
